<Window x:Class="Lume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lume" Height="700" Width="1100"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SidebarItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation To="#E0E0E0" Duration="0:0:0.2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                <ColorAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseInOut"/>
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation To="Transparent" Duration="0:0:0.2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LiquidCircleBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.06" Direction="270" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FAFAFA"/>
                    <Setter Property="BorderBrush" Value="#E5E5E5"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CapsuleIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MacSearchRing" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#F3C380"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Margin="0,2,0,2" Opacity="0">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" 
                                                        Background="#35000000" 
                                                        CornerRadius="4" 
                                                        Margin="3,0,3,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#50000000"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#70000000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="RangeBase.ValueChanged">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.1" 
                                                         Storyboard.TargetName="PART_Track" 
                                                         Storyboard.TargetProperty="Opacity"/>
                                        <DoubleAnimation To="0" Duration="0:0:0.4" BeginTime="0:0:1.0" 
                                                         Storyboard.TargetName="PART_Track" 
                                                         Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.15" 
                                                         Storyboard.TargetName="PART_Track" 
                                                         Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation To="0" Duration="0:0:0.4" BeginTime="0:0:0.5" 
                                                         Storyboard.TargetName="PART_Track" 
                                                         Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="MinHeight" Value="12"/>
                                <Setter TargetName="PART_Track" Property="Margin" Value="2,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FCFCFC" Offset="0.0"/>
                    <GradientStop Color="#F4F4F4" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#D0D0D0"/>
            </Border.BorderBrush>
            <Border.BorderThickness>0,0,0,1</Border.BorderThickness>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <Ellipse Width="12" Height="12" Fill="#FF5F56" Stroke="#E0443E" StrokeThickness="0.5" Cursor="Hand" MouseLeftButtonDown="BtnClose_Click" ToolTip="关闭"/>
                        <Ellipse Width="12" Height="12" Fill="#FFBD2E" Stroke="#DEA123" StrokeThickness="0.5" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonDown="BtnMinimize_Click" ToolTip="最小化"/>
                        <Ellipse Width="12" Height="12" Fill="#27C93F" Stroke="#1AAB29" StrokeThickness="0.5" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonDown="BtnMaximize_Click" ToolTip="最大化"/>

                        <Button Style="{StaticResource LiquidCircleBtn}" Click="BtnToggleSidebar_Click" Margin="15,0,0,0" ToolTip="切换边栏">
                            <Path Data="M3,4 L13,4 C14.6,4 16,5.4 16,7 L16,13 C16,14.6 14.6,16 13,16 L3,16 C1.4,16 0,14.6 0,13 L0,7 C0,5.4 1.4,4 3,4 Z M5.5,4 L5.5,16" 
                                  Stroke="#555" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Stretch="Uniform" Width="14" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TopFolderNameText" Text="All Lume" FontSize="13" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>

                            <Border Background="#F2F2F2" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="9" FontWeight="Bold" Foreground="#999999" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="TopNoteCountText" Text="0 notes" FontSize="11" Foreground="#999999" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">

                        <Button Style="{StaticResource LiquidCircleBtn}" Margin="0,0,10,0">
                            <Path Data="M3,8 L3.01,8 M8,8 L8.01,8 M13,8 L13.01,8" 
                                  Stroke="#666" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="4"/>
                        </Button>

                        <Button x:Name="BtnTopAddNote" Style="{StaticResource LiquidCircleBtn}" Click="BtnAddNote_Click" ToolTip="新建笔记" Margin="0,0,15,0">
                            <Path Data="M12.5,3.5 L14.5,5.5 L7.5,12.5 L4.5,13 L5,10 Z M11,5 L13,7 M3,3 L3,16 C3,16.5 3.5,17 4,17 L17,17 C17.5,17 18,16.5 18,16 L18,8" 
                                  Stroke="#555" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>

                        <Rectangle Width="1" Height="18" Fill="#D0D0D0" Margin="0,0,15,0"/>

                        <Border Background="#FFFFFF" CornerRadius="16" Margin="0,0,15,0" BorderBrush="#F0F0F0" BorderThickness="1" Padding="4,2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.06" Direction="270" Color="Black"/>
                            </Border.Effect>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnAa" Style="{StaticResource CapsuleIconBtn}" Click="BtnAa_Click">
                                    <TextBlock Text="Aa" FontWeight="SemiBold" FontSize="15" Foreground="#555" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                </Button>
                                <Popup x:Name="TextFormatPopup" 
       PlacementTarget="{Binding ElementName=BtnAa}" 
       Placement="Bottom" 
       StaysOpen="False" 
       AllowsTransparency="True" 
       VerticalOffset="6"
       HorizontalOffset="-20">

                                    <Border Background="#FFFFFF" CornerRadius="16" BorderBrush="#F0F0F0" BorderThickness="1" Padding="4,2" Margin="10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.06" Direction="270" Color="Black"/>
                                        </Border.Effect>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource CapsuleIconBtn}" Click="BtnFormatBold_Click" ToolTip="加粗">
                                                <TextBlock Text="B" FontWeight="Bold" FontSize="15" Foreground="#555" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Style="{StaticResource CapsuleIconBtn}" Click="BtnFormatItalic_Click" ToolTip="斜体">
                                                <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" FontSize="15" Foreground="#555" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Style="{StaticResource CapsuleIconBtn}" Click="BtnFormatUnderline_Click" ToolTip="下划线">
                                                <TextBlock Text="U" TextDecorations="Underline" FontWeight="SemiBold" FontSize="15" Foreground="#555" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Style="{StaticResource CapsuleIconBtn}" Click="BtnFormatStrikethrough_Click" ToolTip="删除线">
                                                <TextBlock Text="S" TextDecorations="Strikethrough" FontWeight="SemiBold" FontSize="15" Foreground="#555" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <Button Style="{StaticResource CapsuleIconBtn}">
                                    <Path Data="M4,5 L4.01,5 M8,5 L15,5 M4,10 L4.01,10 M8,10 L15,10 M4,15 L4.01,15 M8,15 L15,15" 
                                          Stroke="#555" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="13"/>
                                </Button>
                                <Button Style="{StaticResource CapsuleIconBtn}">
                                    <Path Data="M3,5 C3,3.9 3.9,3 5,3 L15,3 C16.1,3 17,3.9 17,5 L17,13 C17,14.1 16.1,15 15,15 L5,15 C3.9,15 3,14.1 3,13 Z M7,3 L7,15 M12,3 L12,15 M3,9 L17,9" 
                                          Stroke="#555" StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" Width="15" Height="13"/>
                                </Button>
                                <Button Style="{StaticResource CapsuleIconBtn}">
                                    <Path Data="M9.5,7 L9.5,13 C9.5,14.6 8.2,16 6.5,16 C4.8,16 3.5,14.6 3.5,13 L3.5,6 C3.5,3.8 5.3,2 7.5,2 C9.7,2 11.5,3.8 11.5,6 L11.5,12 C11.5,12.8 10.8,13.5 10,13.5 C9.2,13.5 8.5,12.8 8.5,12 L8.5,7" 
                                          Stroke="#555" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" Width="11" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource LiquidCircleBtn}" Margin="0,0,15,0">
                            <Path Data="M8,1 L8,11 M4,5 L8,1 L12,5 M3.5,10 L3.5,15 C3.5,16.1 4.4,17 5.5,17 L10.5,17 C11.6,17 12.5,16.1 12.5,15 L12.5,10" 
                                  Stroke="#555" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Stretch="Uniform" Width="13" Height="15"/>
                        </Button>

                        <Border x:Name="SearchRing" Style="{StaticResource MacSearchRing}" Width="160" Height="35">
                            <Border Background="#F4F4F4" CornerRadius="15" BorderBrush="#EAEAEA" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M10,10 L14,14 M6,11 A5,5 0 1,1 6,1 A5,5 0 1,1 6,11 Z" 
                                          Stroke="#888" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center"/>

                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Search" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="SearchTextBox" Grid.Column="0" Text="" Foreground="#555" Background="Transparent" BorderThickness="0" FontSize="13" VerticalAlignment="Center" TextChanged="SearchTextBox_TextChanged"/>

                                        <Button x:Name="BtnClearSearch" Grid.Column="1" Content="✕" FontSize="12" Foreground="#999" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClearSearch_Click" Visibility="Collapsed" Padding="6,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="SidebarPanel" Width="200" Grid.Row="1" Grid.Column="0" Background="#F5F5F7" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,10,15,5">
                    <TextBlock Text="分类" FontSize="14" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                    <TextBlock Text="+" FontSize="20" FontWeight="Bold" Foreground="#888" Cursor="Hand" HorizontalAlignment="Right" MouseLeftButtonDown="BtnAddFolder_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FolderListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
            <Grid Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,10,15,5">
                    <TextBlock Text="Notes" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BtnAddNoteText" Text="+" FontSize="24" FontWeight="Bold" Foreground="#333" Cursor="Hand" HorizontalAlignment="Right" MouseLeftButtonDown="BtnAddNote_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NoteListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="RightEditArea" Grid.Row="1" Grid.Column="2" Background="#FFFFFF" MouseDown="EditorArea_MouseDoubleClick">
            <Grid Margin="20,10,20,0">

                <TextBlock x:Name="EmptyStateText" Text="单击此处新建笔记" Foreground="#CCCCCC" FontSize="24" FontWeight="Bold" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                <Grid x:Name="EditorContainer" Visibility="Collapsed" PreviewMouseWheel="EditorContainer_PreviewMouseWheel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="FolderPathText" Text="归档于..." Grid.Row="0" Foreground="#AAA" HorizontalAlignment="Left" FontSize="11"/>

                    <TextBlock x:Name="StatusText" Text="编辑中..." Grid.Row="0" Foreground="#AAA" HorizontalAlignment="Right" FontSize="11"/>

                    <TextBox x:Name="NoteTitleBox" Grid.Row="1" Text="新笔记" FontSize="28" FontWeight="Bold" 
         FontFamily="Segoe UI Emoji, Segoe UI, Microsoft YaHei UI, sans-serif"
         BorderThickness="0" Background="Transparent" Margin="0,10,0,10" 
         TextChanged="Editor_TextChanged"/>

                    <avalonEdit:TextEditor x:Name="NoteEditor" Grid.Row="2" 
                       Background="Transparent" BorderThickness="0"
                       FontSize="15" 
                       FontFamily="Segoe UI Emoji, Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif"
                       WordWrap="True" 
                       ShowLineNumbers="False"
                       TextChanged="NoteEditor_TextChanged">
                        <avalonEdit:TextEditor.Options>
                            <avalonEdit:TextEditorOptions InheritWordWrapIndentation="False"/>
                        </avalonEdit:TextEditor.Options>
                    </avalonEdit:TextEditor>

                    <Border Grid.Row="3" BorderBrush="#E5E5E5" Padding="0,5,0,5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="CursorPositionText" Text="第 1 行，第 1 列" Foreground="#A0A0A0" FontSize="11.5" Margin="0,0,25,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CharCountText" Text="0 个字符" Foreground="#A0A0A0" FontSize="11.5" Margin="0,0,25,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ZoomText" Text="100%" Foreground="#A0A0A0" FontSize="11.5" Margin="0,0,25,0" VerticalAlignment="Center"/>
                            <TextBlock Text="UTF-8" Foreground="#A0A0A0" FontSize="11.5" Margin="0,0,25,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lume 笔记" Foreground="#A0A0A0" FontSize="11.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="DeleteConfirmDialog" Visibility="Collapsed" Background="#40000000" Grid.RowSpan="2" Grid.ColumnSpan="3" MouseLeftButtonDown="DeleteConfirmDialog_MouseDown">
            <Border Background="#FFFFFF" CornerRadius="22" Width="260" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.15" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,15,0,0">
                        <TextBlock Text="确认回收至垃圾篓吗？" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#333333"/>
                        <TextBlock Text="此操作将无法撤销！" FontSize="12" HorizontalAlignment="Center" Foreground="#888888" Margin="0,5,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="取消" Width="90" Height="30" Margin="0,0,15,0" Background="#E5E5E5" Foreground="#333333" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnCancelDelete_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="删除" Width="90" Height="30" Background="#FF3B30" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnConfirmDelete_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>