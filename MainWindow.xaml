<Window x:Class="Lume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lume" Height="700" Width="1100"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SidebarItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation To="#E0E0E0" Duration="0:0:0.2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                <ColorAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseInOut"/>
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation To="Transparent" Duration="0:0:0.2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" 
                Grid.ColumnSpan="3" 
                Background="#FFFFFF" 
                BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" 
                MouseLeftButtonDown="Window_MouseLeftButtonDown">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                <Ellipse Width="12" Height="12" Fill="#FFBD2E" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="BtnMinimize_Click" ToolTip="最小化"/>
                <Ellipse Width="12" Height="12" Fill="#27C93F" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="BtnMaximize_Click" ToolTip="最大化"/>
                <Ellipse Width="12" Height="12" Fill="#FF5F56" Cursor="Hand" MouseLeftButtonDown="BtnClose_Click" ToolTip="关闭"/>
            </StackPanel>

        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F7" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,10,15,5">
                    <TextBlock Text="分类" FontSize="14" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                    <TextBlock Text="+" FontSize="20" FontWeight="Bold" Foreground="#888" Cursor="Hand" HorizontalAlignment="Right" MouseLeftButtonDown="BtnAddFolder_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FolderListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
            <Grid Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,10,15,5">
                    <TextBlock Text="Notes" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="+" FontSize="24" FontWeight="Bold" Foreground="#333" Cursor="Hand" HorizontalAlignment="Right" MouseLeftButtonDown="BtnAddNote_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NoteListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="RightEditArea" Grid.Row="1" Grid.Column="2" Background="#FFFFFF" MouseDown="EditorArea_MouseDoubleClick">
            <Grid Margin="30,10,30,20">

                <TextBlock x:Name="EmptyStateText" Text="单击此处新建笔记" Foreground="#CCCCCC" FontSize="24" FontWeight="Bold" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                <Grid x:Name="EditorContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="StatusText" Text="编辑中..." Grid.Row="0" Foreground="#AAA" HorizontalAlignment="Right" FontSize="11"/>

                    <TextBox x:Name="NoteTitleBox" Grid.Row="1" Text="新笔记" FontSize="28" FontWeight="Bold" 
                             BorderThickness="0" Background="Transparent" Margin="0,10,0,10" 
                             TextChanged="Editor_TextChanged"/>

                    <RichTextBox x:Name="NoteEditor" Grid.Row="2" BorderThickness="0" Background="Transparent"
                                 TextChanged="Editor_TextChanged" FontSize="15" FontFamily="Segoe UI">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                        <FlowDocument>
                            <Paragraph></Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="DeleteConfirmDialog" Visibility="Collapsed" Background="#40000000" Grid.RowSpan="2" Grid.ColumnSpan="3">
            <Border Background="#F9F9F9" CornerRadius="12" Width="260" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.15" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,15,0,0">
                        <TextBlock Text="确认删除吗？" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#333333"/>
                        <TextBlock Text="此操作将无法撤销。" FontSize="12" HorizontalAlignment="Center" Foreground="#888888" Margin="0,5,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="取消" Width="90" Height="30" Margin="0,0,15,0" Background="#E5E5E5" Foreground="#333333" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnCancelDelete_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="删除" Width="90" Height="30" Background="#FF3B30" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnConfirmDelete_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>